# 生产环境配置。复制为 .env.production 后填写，不要提交到仓库。
# 纯 Linux 部署：deploy/linux/install.sh 会自动生成这个文件并填好数据库与密钥，你只需补 ADMIN_* 和 SMTP_*。
# Docker 部署：这个文件同时被 docker compose 用来插值（--env-file）和注入容器（env_file）。
# 值里如果有空格或 # 号，用双引号包起来。

# ---- 域名 ----
# 正式域名，Caddy 会自动申请 HTTPS 证书；DNS 的 A 记录要先指到服务器。备案期间用 IP 测试可写  DOMAIN=:80
DOMAIN=example.com
SITE_URL=https://example.com
SITE_NAME=方块寄售平台
SITE_TZ=Asia/Shanghai

# ---- 数据库 ----
# 纯 Linux：postgres://mc:密码@127.0.0.1:5432/mc_consign
# Docker：  postgres://mc:密码@db:5432/mc_consign（密码要与下面 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgres://mc:换成一串随机密码@127.0.0.1:5432/mc_consign
POSTGRES_USER=mc
POSTGRES_PASSWORD=换成一串随机密码
POSTGRES_DB=mc_consign

# ---- 安全 ----
# 至少 32 位随机字符串，生成：openssl rand -hex 32
SESSION_SECRET=

# ---- 首个超管（只在第一次初始化时创建；至少 12 位，不能是默认口令）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_QQ=
ADMIN_PHONE=

# ---- 邮件（QQ 邮箱 / 企业邮箱 / 阿里云邮件推送）----
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- 上传目录 ----
# 纯 Linux：/opt/mc-consign/uploads   Docker：/data/uploads
UPLOAD_DIR=/opt/mc-consign/uploads

# ---- Hypixel 官方数据 ----
HYPIXEL_API_KEY=
HYPIXEL_MOCK=

# ---- 页脚 ----
ICP_NUMBER=
PSB_NUMBER=
COMPANY_NAME=

# ---- 备份保留天数 ----
BACKUP_KEEP_DAYS=14
