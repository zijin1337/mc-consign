# 复制为 .env 后按需修改。.env 不入库。

# PostgreSQL 连接串。本地开发默认用 scripts/dev-db.ps1 起的便携版
DATABASE_URL=postgres://postgres@localhost:5432/mc_consign

# 会话签名密钥，生产环境必须换成随机长串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me

# 站点
SITE_NAME=方块寄售平台
SITE_URL=http://localhost:3000
# 展示与质保日期用的时区。Docker 镜像默认 UTC，这里固定成上海，不受服务器 TZ 影响
SITE_TZ=Asia/Shanghai

# 邮件。SMTP_HOST 留空则进入 console 模式，验证码直接打印到服务端日志，方便本地开发
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 上传目录，相对项目根
UPLOAD_DIR=./uploads

# 首个超管，运行 pnpm db:seed 时创建（已存在则跳过）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_QQ=10001
ADMIN_PHONE=13800000000

# Hypixel 官方数据。Key 在 https://developer.hypixel.net 申请：
#   开发 Key 有时效且限 300 次 / 5 分钟，正式上线建议提交应用申请生产 Key。
# 留空且 HYPIXEL_MOCK 不为 1 时，功能对用户隐藏，超管看到配置提示。
HYPIXEL_API_KEY=
# 1 = 模拟数据模式（本地演示用，生产别开）
HYPIXEL_MOCK=

# 页脚：ICP 备案号、公安备案号、运营公司名。备案通过后填写
ICP_NUMBER=
PSB_NUMBER=
COMPANY_NAME=
