# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (user images)
/uploads

# local dev artifacts
/.local

# e2e dev server build dir
/.next-e2e

# 手动验证生产构建时用的独立目录（NEXT_DIST_DIR=.next-build pnpm build）
/.next-build

# server-side backups / data (docker volumes bind here)
/backups
/data
